{
  "name": "md-semantic-search",
  "version": "0.4.0",
  "description": "Local, private semantic (vector) search over any folder of Markdown files. Finds passages by meaning — cross-lingual — using transformers.js. No API keys, no cloud, no vector database.",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "md-semantic-search": "bin/cli.mjs",
    "mdss": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "RESEARCH.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "tsc --noEmit && eslint src/ bin/",
    "lint:eslint": "eslint src/ bin/"
  },
  "keywords": [
    "semantic-search",
    "vector-search",
    "embeddings",
    "markdown",
    "rag",
    "transformers",
    "e5",
    "local",
    "offline",
    "cli"
  ],
  "author": "chelslava",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chelslava/md-semantic-search.git"
  },
  "homepage": "https://github.com/chelslava/md-semantic-search#readme",
  "bugs": {
    "url": "https://github.com/chelslava/md-semantic-search/issues"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "typescript": "^7.0.2"
  }
}
