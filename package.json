{
  "name": "md-semantic-search",
  "version": "1.0.3",
  "description": "Local, private semantic (vector) search over any folder of Markdown files. Finds passages by meaning — cross-lingual — using transformers.js. No API keys, no cloud, no vector database.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "md-semantic-search": "bin/cli.mjs",
    "mdss": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "README.md",
    "RESEARCH.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-functions=85 --test-coverage-branches=80",
    "lint": "tsc --noEmit && eslint bin/ test/ bench/ scripts/",
    "lint:eslint": "eslint bin/ test/ bench/ scripts/",
    "docs:build": "node scripts/build-docs.mjs"
  },
  "keywords": [
    "semantic-search",
    "vector-search",
    "embeddings",
    "markdown",
    "rag",
    "transformers",
    "e5",
    "local",
    "offline",
    "cli"
  ],
  "author": "chelslava",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chelslava/md-semantic-search.git"
  },
  "homepage": "https://github.com/chelslava/md-semantic-search#readme",
  "bugs": {
    "url": "https://github.com/chelslava/md-semantic-search/issues"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.125.0",
    "eslint": "^10.8.1",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "typescript": "^7.0.2"
  }
}
